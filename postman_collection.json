{
  "info": {
    "name": "SGECN Backend API",
    "description": "Collection complète des endpoints API SGECN",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Doe\",\n  \"prenom\": \"John\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sgecn.cm\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/verify-email",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "verify-email"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Concours",
      "item": [
        {
          "name": "List Open Concours",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/concours/ouverts",
              "host": ["{{base_url}}"],
              "path": ["api", "concours", "ouverts"]
            }
          }
        },
        {
          "name": "Get Concours Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/concours/1",
              "host": ["{{base_url}}"],
              "path": ["api", "concours", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Candidatures",
      "item": [
        {
          "name": "Submit Candidature",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "concours_id",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "centre_depot_id",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "date_naissance",
                  "value": "2000-01-01",
                  "type": "text"
                },
                {
                  "key": "document_cni",
                  "type": "file"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/candidat/candidatures",
              "host": ["{{base_url}}"],
              "path": ["api", "candidat", "candidatures"]
            }
          }
        },
        {
          "name": "List My Candidatures",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/candidat/candidatures",
              "host": ["{{base_url}}"],
              "path": ["api", "candidat", "candidatures"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/dashboard",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "dashboard"]
            }
          }
        },
        {
          "name": "Global Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/statistiques/globales",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "statistiques", "globales"]
            }
          }
        },
        {
          "name": "Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/audit-logs",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "audit-logs"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    }
  ]
}
